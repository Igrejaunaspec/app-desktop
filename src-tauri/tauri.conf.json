{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Igreja UNASP EC",
  "version": "1.0.0",
  "identifier": "com.igrejaunaspec.app",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Igreja UNASP EC",
        "url": "https://igrejaunaspec.com/",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "devtools": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Productivity",
    "shortDescription": "App da Igreja Adventista UNASP EC",
    "copyright": "Igreja Adventista UNASP EC",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.icns","icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "10.15", "signingIdentity": "-" }
  }
}
